/* ============================================
   TOKENS
   ============================================ */
:root {
  /* colors */
  --color-bg: #ffffff;
  --color-surface: #d9d9d9;
  --color-text: #000000;
  --color-text-muted: #4a4a4a;
  --color-black: #000000;
  --color-white: #ffffff;
  --color-border: #000000;

  /* layout */
  --container-max: 1440px;
  --content-max: 1200px;
  --side-padding: 100px;
  --grid-gap: 32px;

  /* typography */
  --fs-h1: 40px;
  --fs-h2: 25px;
  --fs-h3: 16px;
  --fs-body: 14px;
  --lh-heading: 1.15;
  --lh-body: 1.5;
  --font-family: "Helvetica Neue", Arial, "Segoe UI", sans-serif;

  /* spacing */
  --space-section: 100px;
  --space-card-gap: 20px;
  --space-paragraph: 12px;
  --space-cta-offset: 32px;
  --space-text-indent: 20px;

  /* misc */
  --radius: 4px;
  --transition: 0.2s ease;
}

@media (max-width: 1023px) {
  :root {
    --side-padding: 40px;
    --space-section: 72px;
    --fs-h1: 32px;
    --fs-h2: 22px;
  }
}

@media (max-width: 599px) {
  :root {
    --side-padding: 20px;
    --space-section: 56px;
    --grid-gap: 16px;
    --fs-h1: 28px;
    --fs-h2: 20px;
  }
}

/* ============================================
   RESET
   ============================================ */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--font-family);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--color-text);
  background: var(--color-bg);
}
img { max-width: 100%; display: block; }
ul { margin: 0; padding: 0; list-style: none; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }
h1, h2, h3, p, dl, dd { margin: 0; }
input { font: inherit; }

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--color-black);
  color: var(--color-white);
  padding: 12px 20px;
  z-index: 1000;
}
.skip-link:focus {
  left: 0;
}

:focus-visible {
  outline: 2px solid var(--color-black);
  outline-offset: 2px;
}

/* ============================================
   LAYOUT / GRID
   ============================================ */
.container {
  max-width: var(--content-max);
  margin-inline: auto;
  padding-inline: var(--side-padding);
}

.section {
  padding-block: calc(var(--space-section) / 2);
}
.section:first-of-type { padding-top: 0; }

.grid-12 {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: var(--grid-gap);
}

/* ============================================
   TYPOGRAPHY
   ============================================ */
h1, .h1 {
  font-size: var(--fs-h1);
  line-height: var(--lh-heading);
  font-weight: 700;
}
h2, .h2, .section-title {
  font-size: var(--fs-h2);
  line-height: var(--lh-heading);
  font-weight: 700;
}
h3, .h3 {
  font-size: var(--fs-h3);
  line-height: var(--lh-heading);
  font-weight: 700;
}
p { font-size: var(--fs-body); }

.section-title {
  margin-bottom: var(--space-paragraph);
}
.section-lead {
  color: var(--color-text-muted);
  max-width: 760px;
  margin-bottom: calc(var(--space-paragraph) * 3);
}
.section-title + .calc-grid,
.section-title + .scenario-grid,
.section-title + .pricing-layout,
.section-title + .two-col-grid,
.section-title + .team-grid,
.section-title + .cases-grid {
  margin-top: calc(var(--space-paragraph) * 3);
}

/* ============================================
   BUTTONS
   ============================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 24px;
  font-size: var(--fs-body);
  font-weight: 500;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background var(--transition), color var(--transition), opacity var(--transition);
}
.btn--primary {
  background: var(--color-black);
  color: var(--color-white);
}
.btn--primary:hover { opacity: 0.85; }
.btn--text {
  padding: 16px 0;
  text-decoration: underline;
  text-underline-offset: 4px;
}

/* ============================================
   HEADER
   ============================================ */
.header {
  border-bottom: 1px solid #ececec;
  position: sticky;
  top: 0;
  background: var(--color-bg);
  z-index: 100;
}
.header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding-block: 20px;
}
.logo {
  border: 1px dashed var(--color-black);
  padding: 10px 20px;
  font-size: var(--fs-body);
  flex-shrink: 0;
}
.nav__list {
  display: flex;
  gap: 32px;
}
.nav__list a {
  font-size: var(--fs-body);
  white-space: nowrap;
}
.nav__list a:hover { text-decoration: underline; }
.nav { flex: 1; display: flex; justify-content: center; }

.phone-link {
  border: 1px dashed var(--color-black);
  padding: 10px 20px;
  font-size: var(--fs-body);
  white-space: nowrap;
  flex-shrink: 0;
}
.phone-link--mobile { display: none; }

.burger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}
.burger span {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--color-black);
  transition: transform var(--transition), opacity var(--transition);
}
.burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.mobile-nav {
  display: none;
  flex-direction: column;
  gap: 24px;
  padding: 24px var(--side-padding) 32px;
  border-top: 1px solid #ececec;
}
.mobile-nav__list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.mobile-nav__list a { font-size: 18px; }
.mobile-nav.is-open { display: flex; }

@media (max-width: 1023px) {
  .nav { display: none; }
  .phone-link { display: none; }
  .phone-link--mobile { display: inline-flex; }
  .burger { display: flex; }
}

/* ============================================
   HERO
   ============================================ */
.hero-section { padding-top: calc(var(--space-section) / 2); }
.hero-box {
  background: var(--color-surface);
  padding: 56px var(--space-text-indent) 48px;
  border-radius: var(--radius);
}
.hero-box__title {
  max-width: 900px;
  margin-bottom: 20px;
}
.hero-box__desc {
  max-width: 520px;
  margin-bottom: 40px;
  color: var(--color-text-muted);
}
.hero-box__stats {
  font-size: var(--fs-h3);
  font-weight: 700;
}

/* ============================================
   SCENARIO GRID
   ============================================ */
.scenario-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-areas:
    ".    .    wide"
    "a    b    c"
    "d    e    text";
  gap: var(--space-card-gap);
}
.scenario-card--wide { grid-area: wide; }
.scenario-grid > *:nth-of-type(2) { grid-area: a; }
.scenario-grid > *:nth-of-type(3) { grid-area: b; }
.scenario-grid > *:nth-of-type(4) { grid-area: c; }
.scenario-grid > *:nth-of-type(5) { grid-area: d; }
.scenario-grid > *:nth-of-type(6) { grid-area: e; }
.scenario-grid > .btn--text { grid-area: text; align-self: center; justify-self: start; }

.scenario-card {
  background: var(--color-surface);
  text-align: left;
  padding: 32px var(--space-text-indent);
  min-height: 96px;
  font-size: var(--fs-h3);
  font-weight: 700;
  border-radius: var(--radius);
  transition: background var(--transition);
}
.scenario-card:hover { background: #cfcfcf; }

@media (max-width: 767px) {
  .scenario-grid {
    grid-template-columns: 1fr;
    grid-template-areas:
      "wide"
      "a"
      "b"
      "c"
      "d"
      "e"
      "text";
  }
  .scenario-grid > .btn--text { justify-self: start; }
}

/* ============================================
   CTA BANNER
   ============================================ */
.cta-banner {
  background: var(--color-surface);
  padding: 56px var(--space-text-indent) var(--space-cta-offset);
  border-radius: var(--radius);
}
.cta-banner--tight { padding-top: 40px; }
.cta-banner__title { max-width: 640px; margin-bottom: var(--space-paragraph); }
.cta-banner__desc { max-width: 640px; color: var(--color-text-muted); margin-bottom: 32px; }
.cta-banner > .btn { margin-top: var(--space-cta-offset); }
.cta-banner__desc + .btn { margin-top: 0; }

/* ============================================
   PROCESS LIST
   ============================================ */
.process-list__item {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: var(--grid-gap);
  padding-block: 32px;
  border-top: 1px solid #d0d0d0;
}
.process-list__item:last-child { border-bottom: 1px solid #d0d0d0; }
.process-list__label {
  font-weight: 700;
  font-size: var(--fs-h3);
}
.process-list__highlight {
  font-weight: 700;
  font-size: var(--fs-h3);
}
.process-list__content--qa {
  display: grid;
  gap: 24px;
}
.qa__q { font-weight: 700; margin-bottom: 4px; }
.qa__a { color: var(--color-text-muted); }

@media (max-width: 767px) {
  .process-list__item { grid-template-columns: 1fr; gap: 12px; }
}

/* ============================================
   CALCULATOR CARDS
   ============================================ */
.calc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-areas:
    "buy sell invest"
    "complex complex complex";
  gap: var(--space-card-gap);
}
.calc-grid > *:nth-of-type(1) { grid-area: buy; }
.calc-grid > *:nth-of-type(2) { grid-area: sell; }
.calc-grid > *:nth-of-type(3) { grid-area: invest; }
.calc-card--wide { grid-area: complex; }

.calc-card {
  background: var(--color-surface);
  padding: 32px var(--space-text-indent) var(--space-cta-offset);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
}
.calc-card__title { margin-bottom: var(--space-paragraph); }
.calc-card__subtitle { font-weight: 700; margin-bottom: 24px; }
.calc-card__label { color: var(--color-text-muted); margin-bottom: var(--space-paragraph); }
.calc-card__list { margin-bottom: 32px; }
.calc-card__list li {
  padding-left: 16px;
  position: relative;
  color: var(--color-text-muted);
  margin-bottom: 6px;
}
.calc-card__list li::before {
  content: "•";
  position: absolute;
  left: 0;
}
.calc-card__text { color: var(--color-text-muted); max-width: 640px; margin-bottom: 32px; }
.calc-card__btn { margin-top: auto; align-self: flex-start; }

.calc-note {
  margin-top: calc(var(--space-paragraph) * 3);
  font-weight: 700;
  font-size: var(--fs-h3);
  max-width: 420px;
}

@media (max-width: 767px) {
  .calc-grid {
    grid-template-columns: 1fr;
    grid-template-areas: "buy" "sell" "invest" "complex";
  }
}

/* ============================================
   PRICING TABLE (house building)
   ============================================ */
.pricing-layout {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: var(--grid-gap);
  align-items: start;
  margin-bottom: calc(var(--space-paragraph) * 3);
}
.pricing-table__row {
  border-bottom: 1px solid var(--color-black);
  padding-block: 20px;
}
.pricing-table__main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: var(--fs-h2);
  font-weight: 700;
  margin-bottom: 6px;
}
.pricing-table__note {
  color: var(--color-text-muted);
  display: flex;
  justify-content: space-between;
  gap: 12px;
}
.pricing-table__badge { white-space: nowrap; }
.pricing-image {
  background: var(--color-surface);
  min-height: 320px;
  border-radius: var(--radius);
}

@media (max-width: 767px) {
  .pricing-layout { grid-template-columns: 1fr; }
  .pricing-image { order: -1; min-height: 220px; }
}

/* ============================================
   ACCORDION
   ============================================ */
.accordion {
  border-top: 1px solid var(--color-black);
  margin-bottom: calc(var(--space-paragraph) * 3);
}
.accordion__trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: 24px;
  font-size: var(--fs-h2);
  font-weight: 700;
  text-align: left;
}
.accordion__icon {
  font-size: 28px;
  font-weight: 400;
  transition: transform var(--transition);
  line-height: 1;
}
.accordion__trigger[aria-expanded="true"] .accordion__icon { transform: rotate(45deg); }
.accordion__panel { padding-bottom: 24px; }
.accordion__list li {
  padding-left: 16px;
  position: relative;
  color: var(--color-text-muted);
  margin-bottom: 8px;
}
.accordion__list li::before { content: "•"; position: absolute; left: 0; }

/* ============================================
   TWO-COL / INFO CARDS
   ============================================ */
.two-col-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-card-gap);
  margin-bottom: calc(var(--space-paragraph) * 3);
}
.info-card {
  background: var(--color-surface);
  padding: 32px var(--space-text-indent);
  border-radius: var(--radius);
}
.info-card__title { margin-bottom: 24px; }
.info-card__list li {
  padding-left: 16px;
  position: relative;
  margin-bottom: 8px;
}
.info-card__list li::before { content: "•"; position: absolute; left: 0; }

@media (max-width: 767px) {
  .two-col-grid { grid-template-columns: 1fr; }
}

/* ============================================
   SPLIT CTA (text + button)
   ============================================ */
.split-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--grid-gap);
  flex-wrap: wrap;
}
.split-cta__text {
  font-weight: 700;
  font-size: var(--fs-h3);
  max-width: 520px;
}
.split-cta__sub {
  color: var(--color-text-muted);
  max-width: 480px;
  margin-top: var(--space-paragraph);
}

/* ============================================
   CASE STUDIES
   ============================================ */
.cases-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-card-gap);
  margin-bottom: calc(var(--space-paragraph) * 3);
}
.case-card {
  display: flex;
  flex-direction: column;
}
.case-card__body {
  background: var(--color-surface);
  padding: 32px var(--space-text-indent);
  border-radius: var(--radius);
  margin-bottom: 0;
}
.case-card__title { margin-bottom: 20px; }
.case-card__subtitle { color: var(--color-text-muted); margin-bottom: 20px; }
.case-card__text { color: var(--color-text); }
.case-card__stats {
  border-top: 1px solid var(--color-black);
  padding-top: 16px;
  margin-top: 24px;
}
.case-card__stats > div {
  display: flex;
  justify-content: space-between;
  padding-block: 8px;
  border-bottom: 1px solid #e2e2e2;
  font-weight: 700;
}
.case-card__stats > div:last-child { border-bottom: none; }

@media (max-width: 767px) {
  .cases-grid { grid-template-columns: 1fr; }
}

/* ============================================
   TEAM
   ============================================ */
.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-card-gap);
  margin-bottom: calc(var(--space-paragraph) * 4);
}
.team-card__photo {
  background: var(--color-surface);
  aspect-ratio: 1 / 1;
  border-radius: var(--radius);
  margin-bottom: 24px;
}
.team-card__name { margin-bottom: 4px; }
.team-card__role { color: var(--color-text-muted); margin-bottom: 20px; }
.team-card__specialty li { margin-bottom: 4px; }

@media (max-width: 767px) {
  .team-grid { grid-template-columns: 1fr; }
}

/* ============================================
   CONTACTS
   ============================================ */
.contacts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1.4fr;
  gap: var(--grid-gap);
}
.contacts-info__label { margin-bottom: 8px; margin-top: 28px; }
.contacts-info__label:first-child { margin-top: 0; }
.contacts-info p, .contacts-address p { margin-bottom: 4px; }
.contacts-info a:hover, .contacts-address a:hover { text-decoration: underline; }

.social-list {
  display: flex;
  gap: 12px;
  margin-top: 8px;
}
.social-list a {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-black);
  border-radius: 50%;
  font-size: 11px;
  font-weight: 700;
}
.social-list a:hover { background: var(--color-black); color: var(--color-white); }

.contacts-map {
  background: var(--color-surface);
  min-height: 260px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: var(--fs-h3);
}

@media (max-width: 1023px) {
  .contacts-grid { grid-template-columns: 1fr 1fr; }
  .contacts-map { grid-column: 1 / -1; }
}
@media (max-width: 599px) {
  .contacts-grid { grid-template-columns: 1fr; }
}

/* ============================================
   FOOTER
   ============================================ */
.footer {
  background: var(--color-surface);
  margin-top: var(--space-section);
}
.footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding-block: 32px;
  flex-wrap: wrap;
}
.logo--footer { flex-shrink: 0; }
.footer__legal p, .footer__requisites p { margin-bottom: 4px; font-size: 12px; color: var(--color-text-muted); }
.footer__legal a:hover { text-decoration: underline; }
.footer__cta {
  display: flex;
  align-items: center;
  gap: 16px;
  font-weight: 700;
}

@media (max-width: 767px) {
  .footer__inner { flex-direction: column; align-items: flex-start; }
}

/* ============================================
   MODAL
   ============================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
}
.modal-overlay[hidden] { display: none; }
.modal {
  background: var(--color-white);
  max-width: 440px;
  width: 100%;
  padding: 40px var(--space-text-indent) var(--space-cta-offset);
  border-radius: var(--radius);
  position: relative;
}
.modal__close {
  position: absolute;
  top: 16px;
  right: 16px;
  font-size: 24px;
  width: 32px;
  height: 32px;
}
.modal__title { margin-bottom: var(--space-paragraph); padding-right: 32px; }
.modal__desc { color: var(--color-text-muted); margin-bottom: 24px; }
.modal__form { display: flex; flex-direction: column; gap: 16px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field__label { font-weight: 700; font-size: 12px; }
.field__input {
  border: 1px solid var(--color-black);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-size: var(--fs-body);
}
.field__submit { margin-top: var(--space-paragraph); }
.field__note { font-size: 12px; color: var(--color-text-muted); text-align: center; margin-top: 4px; }

/* ============================================
   RESPONSIVE: general section spacing
   ============================================ */
@media (max-width: 1023px) {
  .calc-note { max-width: 100%; }
}
